# =============================================================================
# مؤسسة بروج المميزة للسياحة - إعدادات متغيرات البيئة
# =============================================================================

# إعدادات Firebase Client
apiKey=your_firebase_api_key
projectId=your_firebase_project_id
authDomain=your_project.firebaseapp.com
storageBucket=your_project.appspot.com
messagingSenderId=your_sender_id
appId=your_firebase_app_id

# =============================================================================
# بوابة الدفع الإلكتروني المباشر (ميسار - Moyasar)
# متوافقة مع اشتراطات وزارة السياحة (فيزا وماستركارد معاً)
# =============================================================================
# مفاتيح بيئة التجربة (Sandbox): تبدأ بـ sk_test_ و pk_test_
# مفاتيح بيئة الإنتاج المباشرة (Live): تبدأ بـ sk_live_ و pk_live_
MOYASAR_SECRET_KEY=sk_test_demo_secret_key_here
NUXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=pk_test_demo_publishable_key_here
